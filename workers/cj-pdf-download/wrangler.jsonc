{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mathtoolshub-cj-pdf-download",
  "main": "src/index.js",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "INSTALLERS",
      "bucket_name": "mathtoolshub-cj-pdf-installers"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
